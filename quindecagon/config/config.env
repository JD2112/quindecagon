# ============================================================================
# nf-security-tools — Configuration
# ============================================================================

# CVSS threshold (fail if exceeded)
CVSS_THRESHOLD=9.0

# Pipeline directory (set by run_all_checks.sh, fallback to current dir)
PIPELINE_DIR="${PIPELINE_DIR:-$(pwd)}"

# Report output paths — stored inside the security suite, never in the target
# REPORT_DIR and RAW_DIR are set by run_all_checks.sh (timestamped).
# Only use defaults here if they haven't been set yet.
REPORT_DIR="${REPORT_DIR:-${REPORT_BASE:-.}/reports}"
RAW_DIR="${RAW_DIR:-${REPORT_DIR}/raw}"

# Container image to scan (can be overridden via CLI)
CONTAINER_IMAGE="${CONTAINER_IMAGE:-your_docker_image:latest}"

# Cosign Public Key (path to .pub file or literal key)
# Generate with: cosign generate-key-pair
COSIGN_PUBLIC_KEY="/app/cosign.pub"

# Scanner Thresholds
GRYPE_SEVERITY_THRESHOLD="critical"
DOCKER_SCOUT_THRESHOLD="critical"

# Cleanup - Set to true to remove images pulled during the scan
CLEANUP_IMAGES=true
